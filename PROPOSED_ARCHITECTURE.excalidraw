      "link": null,
      "locked": false,
      "text": "Building blocks are stable responsibility boundaries. Listed items are capabilities. Dashed boxes are optional extensions. A tool becomes an independent component only when its contract, state, failure, security, scaling, deployment, or operational ownership requires a separate boundary.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
